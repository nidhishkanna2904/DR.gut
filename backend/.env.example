# Dr. Gut backend — environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to git (already in .gitignore).

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Required: PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://dr_gut_user:YOUR_PASSWORD@127.0.0.1:5432/dr_gut

# Optional: override the Claude model (default: claude-sonnet-4-5)
# DR_GUT_MODEL=claude-3-5-sonnet-20241022
